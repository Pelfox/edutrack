{
  "name": "@edutrack/frontend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "api:generate": "openapi-typescript ../backend/docs/swagger.json -o src/api/schema.ts",
    "check": "biome check --config-path ./biome.json .",
    "check:fix": "biome check --config-path ./biome.json --write .",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "vite --port 3000",
    "build": "vite build",
